# Copier vers `.env` (jamais commité). Aucune valeur réelle ici.

APP_URL=http://localhost:3000

# Postgres (Drizzle). Exemple Neon / autre hébergeur.
DATABASE_URL=

# Redis local pour les tâches de fond (BullMQ).
REDIS_URL=redis://127.0.0.1:6379

# Secret Better Auth (générer localement avec 32 octets aléatoires minimum).
BETTER_AUTH_SECRET=

# Activer seulement après configuration du secret et application de la migration Drizzle.
BETTER_AUTH_ENABLED=false
VITE_BETTER_AUTH_ENABLED=false

# URL directe dédiée aux migrations, si Supabase fournit une connexion séparée.
# Ne pas utiliser un pooler transactionnel pour les migrations.
DIRECT_URL=

# Secret de session (≥ 32 caractères aléatoires). Générer en local, ne pas coller dans Git.
SESSION_SECRET=

# Chiffrement des tokens OAuth Gmail (32 octets en hex = 64 caractères).
TOKEN_ENCRYPTION_KEY=

# Google OAuth — identifiants Application Web. Ne jamais préfixer par VITE_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# URI de retour Better Auth à autoriser dans Google Cloud avant activation :
# http://localhost:3000/api/auth/callback/google

# Gmail en lecture seule (OAuth distinct du login Google).
# Ajouter cette URI aux redirections autorisées du client Web Google OAuth.
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/auth/gmail/callback
